# ─── Core (required) ───────────────────────────────────────────────
NODE_ENV=production
PORT=8000
TZ=Africa/Nairobi
DATABASE_URL="postgresql://user:password@host:5432/salon?schema=public"
# Generate with: openssl rand -hex 48   (never reuse the example)
JWT_SECRET=""
# The public https URL of the site. Used in SMS links, CORS and secure cookies.
PUBLIC_BOOKING_BASE_URL="https://book.yoursalon.co.ke"

# Serve the built React app from this same server (recommended: one URL, no CORS).
SERVE_CLIENT=true
CLIENT_DIST=../client/dist

# ─── First-run owner account (used by `npm run seed`) ──────────────
SEED_BUSINESS_NAME="Beautifully Bold Hair"
SEED_OWNER_EMAIL="owner@yoursalon.co.ke"
SEED_OWNER_PHONE="0700000000"
# Leave empty to have a random temporary password printed once.
SEED_OWNER_PASSWORD=""

# ─── Cloudinary gallery photos (optional; free account at cloudinary.com) ─
# Dashboard > Settings > API Keys. Without these the Gallery page explains how to set it up.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── M-Pesa deposits (optional; without these, online booking is free) ─
MPESA_ENVIRONMENT=sandbox          # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
# Must be public https. Append your own secret so only Safaricom (who you gave the URL) can call it:
MPESA_CALLBACK_URL="https://c7a6-102-210-58-157.ngrok-free.app/api/v1/public/payment-callback?secret=CHANGE_ME"
MPESA_CALLBACK_SECRET="CHANGE_ME"

# ─── SMS (optional; without it SMS are only logged) ─────────────────
# TalkSasa (preferred): the API token from your TalkSasa dashboard and an approved sender ID (max 11 characters).
TALKSASA_API_TOKEN=""
TALKSASA_SENDER_ID=""
# TALKSASA_BASE_URL="https://bulksms.talksasa.com/api/v3"
# Or Africa's Talking instead:
SMS_USERNAME=""
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID=""

# ─── Email via Brevo (optional; needed for "forgot password") ──────
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""

# ─── Tuning ────────────────────────────────────────────────────────
SLOT_HOLD_MINUTES=10
LOG_LEVEL=info
